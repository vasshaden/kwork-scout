# Kwork.ru credentials — шаблон (v2.1+)
#
# В v2.1 авторизация на kwork.ru выполняется через cookies.txt,
# а не через логин/пароль.
#
# ДЛЯ НОВЫХ ПОЛЬЗОВАТЕЛЕЙ:
#   python3 tools/kwork_check_auth.py
#   — скрипт откроет Chrome на kwork.ru, вы входите вручную,
#     скрипт сам сохранит cookies.txt и завершится.
#
# Подробнее: tools/README.md
#
# ════════════════════════════════════════════════════════════
# Поля ниже — LEGACY (v2.0 и ранее). В v2.1+ не используются.
# Оставлены как документация: напоминание, под каким логином
# создавались cookies.txt.
# ════════════════════════════════════════════════════════════

KWORK_LOGIN=your_email_or_phone_here
KWORK_PASSWORD=your_password_here
